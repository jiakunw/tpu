`timescale 1ns/1ps
`define SD #1

module output_sram #(
    parameter SRAM_DATA_WIDTH = 64,
    parameter SRAM_ADDR_WIDTH = 9
)(
    input   clk,

    // SRAM C
    input   wr_en_c,
    input   rd_en_c,
    input   [SRAM_ADDR_WIDTH-1:0] waddr_c,
    input   [SRAM_ADDR_WIDTH-1:0] raddr_c,
    input   [SRAM_DATA_WIDTH-1:0] wdata_c,
    output  [SRAM_DATA_WIDTH-1:0] rdata_c
);

    wire                       sram_cen_c = ~(wr_en_c | rd_en_c);
    wire                       sram_wen_c = ~wr_en_c;
    wire [SRAM_ADDR_WIDTH-1:0] sram_addr_c = wr_en_c ? waddr_c : (rd_en_c ? raddr_c : {SRAM_ADDR_WIDTH{1'b0}});

    sram_wrapper #(
        .SRAM_DATA_WIDTH (SRAM_DATA_WIDTH),
        .SRAM_ADDR_WIDTH (SRAM_ADDR_WIDTH)
    ) sram_c (
        .clk (clk),
        .cen (sram_cen_c),
        .wen (sram_wen_c),
        .a   (sram_addr_c),
        .d   (wdata_c),
        .q   (rdata_c)
    );

endmodule
