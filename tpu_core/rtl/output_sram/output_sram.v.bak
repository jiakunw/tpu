`timescale 1ns/1ps
`define SD #1

module output_sram #(
    parameter SRAM_DATA_WIDTH = 64,
    parameter SRAM_ADDR_WIDTH = 9
)(
    input   clk,

    // SRAM C
    input   wr_en_c,
    input   rd_en_c,
    input   [SRAM_ADDR_WIDTH-1:0] waddr_c,
    input   [SRAM_ADDR_WIDTH-1:0] raddr_c,
    input   [SRAM_DATA_WIDTH-1:0] wdata_c,
    output  [SRAM_DATA_WIDTH-1:0] rdata_c
);

    wire sram_cs_c;
    reg  [SRAM_ADDR_WIDTH-1:0] sram_addr_c;

    wire sram_cen_delayed_c;
    wire sram_wen_delayed_c;
    wire [SRAM_ADDR_WIDTH-1:0] sram_addr_delayed_c;
    wire [SRAM_DATA_WIDTH-1:0] sram_din_delayed_c;
    wire [SRAM_DATA_WIDTH-1:0] sram_dout_c;

    assign sram_cs_c = wr_en_c | rd_en_c;

    assign `SD sram_cen_delayed_c  = ~sram_cs_c;
    assign `SD sram_wen_delayed_c  = ~wr_en_c;
    assign `SD sram_addr_delayed_c = sram_addr_c;
    assign `SD sram_din_delayed_c  = wdata_c;

    assign rdata_c = sram_dout_c;

    always @(*) begin
        if (wr_en_c)
            sram_addr_c = waddr_c;
        else if (rd_en_c)
            sram_addr_c = raddr_c;
        else
            sram_addr_c = {SRAM_ADDR_WIDTH{1'b0}};
    end

    sram00 sram_c (
        .CLK  (clk),
        .CEN  (sram_cen_delayed_c),
        .WEN  (sram_wen_delayed_c),
        .A    (sram_addr_delayed_c),
        .D    (sram_din_delayed_c),
        .EMA  (3'b010),
        .RETN (1'b1),
        .Q    (sram_dout_c)
    );

endmodule