`timescale 1ns/1ps
`define SD #1

module input_sram #(
    parameter SRAM_DATA_WIDTH = 64,
    parameter SRAM_ADDR_WIDTH = 9
)(
    input   clk,

    // SRAM A
    input   wr_en_a,
    input   rd_en_a,
    input   [SRAM_ADDR_WIDTH-1:0] waddr_a,
    input   [SRAM_ADDR_WIDTH-1:0] raddr_a,
    input   [SRAM_DATA_WIDTH-1:0] wdata_a,
    output  [SRAM_DATA_WIDTH-1:0] rdata_a,

    // SRAM B
    input   wr_en_b,
    input   rd_en_b,
    input   [SRAM_ADDR_WIDTH-1:0] waddr_b,
    input   [SRAM_ADDR_WIDTH-1:0] raddr_b,
    input   [SRAM_DATA_WIDTH-1:0] wdata_b,
    output  [SRAM_DATA_WIDTH-1:0] rdata_b
);

    // -------------------------------------------------------------------------
    // SRAM A
    // -------------------------------------------------------------------------
    sram_wrapper sram_a (
        .clk   (clk),
        .wr_en (wr_en_a),
        .rd_en (rd_en_a),
        .waddr (waddr_a),
        .raddr (raddr_a),
        .wdata (wdata_a),
        .rdata (rdata_a)
    );

    // -------------------------------------------------------------------------
    // SRAM B
    // -------------------------------------------------------------------------
    sram_wrapper sram_b (
        .clk   (clk),
        .wr_en (wr_en_b),
        .rd_en (rd_en_b),
        .waddr (waddr_b),
        .raddr (raddr_b),
        .wdata (wdata_b),
        .rdata (rdata_b)
    );

endmodule
