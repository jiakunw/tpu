@@file 7: delete_metal_fill -shapes { FILLWIRE FILLWIREOPC } -modes all
@file 8:
@file 9: #set box [split [join [dbGet top.fPlan.corebox]]]
@file 10: set box [split [join [eval_legacy {dbGet top.fPlan.corebox}]]]
@file 11: set ne [lindex $box 0]
@file 12: set nw [lindex $box 1]
@file 13: set se [lindex $box 2]
@file 14: set sw [lindex $box 3]
@file 15:
@file 16: #setMetalFill -layer 6 -minDensity 27.00
@file 17: #setMetalFill -layer 7 -minDensity 23.00
@file 18:
