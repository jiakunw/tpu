@file 1: # Rui ("Ray") Xu
@file 2: # Nov 2021
@file 3: # CISL @ Columbia, Kinget Group
@file 4: # Innovus: 4_cts.tcl
@file 5:
@file 6: ###############################################################################
@file 7: # CTS SETTINGS
@file 8: ###############################################################################
@file 9: ### Ensure that sufficient analysis view are active.
@file 10: ### Clock specification generation is fully multi-mode and it is important that views using both functional and scan modes are active.
@file 11: ### Sets global analysis modes for timing analysis.
@file 12: ### onChipVariation --- Calculates the delay for one path based on maximum operating condition while calculating the delay for another path based on minimum operating condition for setup or hold checks
@@file 13: set_db timing_analysis_type ocv
@file 14: ### Removes pessimism from clock paths that have a portion of the clock network in common between the clock source and clock destination paths
@file 15: ## Enables removal of clock reconvergence pessimism for both setup and hold modes when both is specified
@@file 16: set_db timing_analysis_cppr both
@file 17: ###Reports violations for hold and setup checks
@@file 18: set_db timing_analysis_check_type setup
@file 19: #set_db timing_analysis_useful_skew true
@file 20: ### Decide top and bottom routing layers for CTS
@file 21: set clk_tree_top_layer $iv::clk_top_routing_layer
@file 22: set clk_tree_bottom_layer $iv::clk_bottom_routing_layer
@file 23: ### Route all clock nets during CTS
@file 24: set route_clock_nets true
@file 25: set ccopt_effort high
@file 26: ### If this property is set, the CTS algorithm will move logic that appears in the clock tree. "Logic" does not include clock gates, buffers, and inverters in a clock tree, which are always moved unless they are locked, or clock generators that are above the root of the clock tree
@@file 27: set_db cts_move_logic true
@file 28: ### Clock tree definition will, by default, not continue through certain types of cell arc (for instance, the clock to Q arc in a DFF). This property allows you to override the default behavior by specifying the output library pin to which the clock tree should propagate, when it arrives at an instance of the given input library pin.
@file 29: #set_ccopt_property library_trace_through_to -lib_pin <name>
@@file 30: set_db cts_consider_power_intent true
@file 31: set leakage_power_effort none
@file 32: set dynamic_power_effort none
@file 33: ### Specifies whether CCOpt will balance this clock tree. If set to true, CCOpt will not balance or optimize this clock tree. The default is false.
@file 34: #set_db cts_opt_ignore false
@file 35: #### Specifies whether to run diagnostic checks to ensure that clock nets routed by NanoRoute follow route guides. The diagnostic checks compare lengths of estimated routes to the final detailed wiring.
@@file 36: set_db cts_check_route_follows_guide true
@file 37: ### Tells CCOpt to rename all clock tree nets for easy identification later in the flow.
@@file 38: set_db cts_rename_clock_tree_nets true
@file 39: ### This property specifies the current waveform calculation methods when considering EM constraints.No or incorrect method means NOT considering EM constraints.
@file 40: #set_ccopt_property consider_em_constraints avg
@file 41: ### Configure library cells for CTS to use. CTS will use matching falily cells which are NOT dont_use
@file 42: ### NOTE: for buffers, inverters and clock gating use LOW threshold (LVT) cells. In this way the resulting insertion delay will be lower leading to less On Chip Variation.
@@file 43: set_db cts_buffer_cells $vars(cell,clk_bufs)
@@file 44: set_db cts_inverter_cells $vars(cell,clk_invs)
@file 45: #set_ccopt_property clock_gating_cells $vars(cell,clk_gating)
@file 46: ### Include this setting to use inverters in preference to buffers.
@file 47: ### For many, but not all, low geometry processes inverters result in lower insertion delay and power than buffers.
@@file 48: set_db cts_use_inverters true
@file 49:
@file 50: ### Creates a clock tree network with associated skew groups and other clock tree synthesis (CTS) configuration settings based on a multi-mode timing configuration.
@@file 51: create_clock_tree_spec        \
    -views { av_normal_typ }  \
