[03/22 10:45:33    593s] @file 16: source ../scripts/4_cts.tcl
[03/22 10:45:33    593s] #@ Begin verbose source ../scripts/4_cts.tcl (pre)
[03/22 10:45:33    593s] @file 1: # Rui ("Ray") Xu
[03/22 10:45:33    593s] @file 2: # Nov 2021
[03/22 10:45:33    593s] @file 3: # CISL @ Columbia, Kinget Group
[03/22 10:45:33    593s] @file 4: # Innovus: 4_cts.tcl
[03/22 10:45:33    593s] @file 5:
[03/22 10:45:33    593s] @file 6: ###############################################################################
[03/22 10:45:33    593s] @file 7: # CTS SETTINGS
[03/22 10:45:33    593s] @file 8: ###############################################################################
[03/22 10:45:33    593s] @file 9: ### Ensure that sufficient analysis view are active.
[03/22 10:45:33    593s] @file 10: ### Clock specification generation is fully multi-mode and it is important that views using both functional and scan modes are active.
[03/22 10:45:33    593s] @file 11: ### Sets global analysis modes for timing analysis.
[03/22 10:45:33    593s] @file 12: ### onChipVariation --- Calculates the delay for one path based on maximum operating condition while calculating the delay for another path based on minimum operating condition for setup or hold checks
[03/22 10:45:33    593s] @@file 13: set_db timing_analysis_type ocv
[03/22 10:45:33    593s] @file 14: ### Removes pessimism from clock paths that have a portion of the clock network in common between the clock source and clock destination paths
[03/22 10:45:33    593s] @file 15: ## Enables removal of clock reconvergence pessimism for both setup and hold modes when both is specified
[03/22 10:45:33    593s] @@file 16: set_db timing_analysis_cppr both
[03/22 10:45:33    593s] @file 17: ###Reports violations for hold and setup checks
[03/22 10:45:33    593s] @@file 18: set_db timing_analysis_check_type setup
[03/22 10:45:33    593s] @file 19: #set_db timing_analysis_useful_skew true
[03/22 10:45:33    593s] @file 20: ### Decide top and bottom routing layers for CTS
[03/22 10:45:33    593s] @file 21: set clk_tree_top_layer $iv::clk_top_routing_layer
[03/22 10:45:33    593s] @file 22: set clk_tree_bottom_layer $iv::clk_bottom_routing_layer
[03/22 10:45:33    593s] @file 23: ### Route all clock nets during CTS
[03/22 10:45:33    593s] @file 24: set route_clock_nets true
[03/22 10:45:33    593s] @file 25: set ccopt_effort high
[03/22 10:45:33    593s] @file 26: ### If this property is set, the CTS algorithm will move logic that appears in the clock tree. "Logic" does not include clock gates, buffers, and inverters in a clock tree, which are always moved unless they are locked, or clock generators that are above the root of the clock tree
[03/22 10:45:33    593s] @@file 27: set_db cts_move_logic true
[03/22 10:45:33    593s] @file 28: ### Clock tree definition will, by default, not continue through certain types of cell arc (for instance, the clock to Q arc in a DFF). This property allows you to override the default behavior by specifying the output library pin to which the clock tree should propagate, when it arrives at an instance of the given input library pin.
[03/22 10:45:33    593s] @file 29: #set_ccopt_property library_trace_through_to -lib_pin <name>
[03/22 10:45:33    593s] @@file 30: set_db cts_consider_power_intent true
[03/22 10:45:33    593s] @file 31: set leakage_power_effort none
[03/22 10:45:33    593s] @file 32: set dynamic_power_effort none
[03/22 10:45:33    593s] @file 33: ### Specifies whether CCOpt will balance this clock tree. If set to true, CCOpt will not balance or optimize this clock tree. The default is false.
[03/22 10:45:33    593s] @file 34: #set_db cts_opt_ignore false
[03/22 10:45:33    593s] @file 35: #### Specifies whether to run diagnostic checks to ensure that clock nets routed by NanoRoute follow route guides. The diagnostic checks compare lengths of estimated routes to the final detailed wiring.
[03/22 10:45:33    593s] @@file 36: set_db cts_check_route_follows_guide true
[03/22 10:45:33    593s] @file 37: ### Tells CCOpt to rename all clock tree nets for easy identification later in the flow.
[03/22 10:45:33    593s] @@file 38: set_db cts_rename_clock_tree_nets true
[03/22 10:45:33    593s] @file 39: ### This property specifies the current waveform calculation methods when considering EM constraints.No or incorrect method means NOT considering EM constraints.
[03/22 10:45:33    593s] @file 40: #set_ccopt_property consider_em_constraints avg
[03/22 10:45:33    593s] @file 41: ### Configure library cells for CTS to use. CTS will use matching falily cells which are NOT dont_use
[03/22 10:45:33    593s] @file 42: ### NOTE: for buffers, inverters and clock gating use LOW threshold (LVT) cells. In this way the resulting insertion delay will be lower leading to less On Chip Variation.
[03/22 10:45:33    593s] @@file 43: set_db cts_buffer_cells $vars(cell,clk_bufs)
[03/22 10:45:33    593s] @@file 44: set_db cts_inverter_cells $vars(cell,clk_invs)
[03/22 10:45:33    593s] @file 45: #set_ccopt_property clock_gating_cells $vars(cell,clk_gating)
[03/22 10:45:33    593s] @file 46: ### Include this setting to use inverters in preference to buffers.
[03/22 10:45:33    593s] @file 47: ### For many, but not all, low geometry processes inverters result in lower insertion delay and power than buffers.
[03/22 10:45:33    593s] @@file 48: set_db cts_use_inverters true
[03/22 10:45:33    593s] @file 49:
[03/22 10:45:33    593s] @file 50: ### Creates a clock tree network with associated skew groups and other clock tree synthesis (CTS) configuration settings based on a multi-mode timing configuration.
[03/22 10:45:33    593s] @@file 51: create_clock_tree_spec        \
[03/22 10:45:33    593s]     -views { av_normal_typ }  \
[03/22 10:45:33    593s]     -keep_all_sdc_clocks      \
[03/22 10:45:33    593s]     -out_file ctsSpec_ccopt.tcl
