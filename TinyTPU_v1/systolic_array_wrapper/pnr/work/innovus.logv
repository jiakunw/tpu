[03/22 11:03:21   4458s] #@ Begin verbose source ../scripts/signoff_timing_analysis.tcl (pre)
[03/22 11:03:21   4458s] @file 1: # Rui ("Ray") Xu
[03/22 11:03:21   4458s] @file 2: # Nov 2021
[03/22 11:03:21   4458s] @file 3: # CISL @ Columbia, Kinget Group
[03/22 11:03:21   4458s] @file 4: # Innovus: signoff_timing_analysis.tcl
[03/22 11:03:21   4458s] @file 5:
[03/22 11:03:21   4458s] @file 6: ###########################################################################
[03/22 11:03:21   4458s] @file 7: # Signoff timing analysis using Innovus (make sure to run the separate
[03/22 11:03:21   4458s] @file 8: # Tempus signoff timing afterwards)
[03/22 11:03:21   4458s] @file 9: ###########################################################################
[03/22 11:03:21   4458s] @file 10:
[03/22 11:03:21   4458s] @file 11: ###############################################################################
[03/22 11:03:21   4458s] @file 12: # Extract and time analysis
[03/22 11:03:21   4458s] @file 13: ###############################################################################
[03/22 11:03:21   4458s] @file 14:
[03/22 11:03:21   4458s] @file 15: proc extract_and_time_design {prefix} {
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]  
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     set_db extract_rc_use_qrc_oa_interface true
[03/22 11:03:21   4458s]     set_db extract_rc_coupled true
[03/22 11:03:21   4458s]     eval_legacy { setDelayCalMode -engine default }
[03/22 11:03:21   4458s]     set_db extract_rc_effort_level signoff
[03/22 11:03:21   4458s]     set_db extract_rc_lef_tech_file_map "../../input/qrc.map"
[03/22 11:03:21   4458s]     set_db timing_analysis_type ocv
[03/22 11:03:21   4458s]     set_db timing_analysis_cppr both
[03/22 11:03:21   4458s]     set_db delaycal_enable_si true
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     extract_rc
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_BEST  -spef_file $iv::OutDir/export_RC_BEST.spef
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_WORST -spef_file $iv::OutDir/export_RC_WORST.spef
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_TYP   -spef_file $iv::OutDir/export_RC_TYP.spef
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     #signoff timing analysis
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     time_design    \
[03/22 11:03:21   4458s]         -sign_off                               \
[03/22 11:03:21   4458s]         -report_only                            \
[03/22 11:03:21   4458s]         -report_prefix $prefix                  \
[03/22 11:03:21   4458s]         -path_report                            \
[03/22 11:03:21   4458s]         -drv_report                             \
[03/22 11:03:21   4458s]         -slack_report                           \
[03/22 11:03:21   4458s]         -num_paths 500                          \
[03/22 11:03:21   4458s]         -report_dir $iv::reportDir           \
[03/22 11:03:21   4458s]         -timing_debug_report
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     time_design    \
[03/22 11:03:21   4458s]         -sign_off                               \
[03/22 11:03:21   4458s]         -hold                                   \
[03/22 11:03:21   4458s]         -report_only                            \
[03/22 11:03:21   4458s]         -report_prefix $prefix                  \
[03/22 11:03:21   4458s]         -path_report                            \
[03/22 11:03:21   4458s]         -slack_report                           \
[03/22 11:03:21   4458s]         -num_paths 500                          \
[03/22 11:03:21   4458s]         -report_dir $iv::reportDir            \
[03/22 11:03:21   4458s]         -timing_debug_report
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s] }
[03/22 11:03:21   4458s] @file 59:
[03/22 11:03:21   4458s] @file 60: # ##############################################################################
[03/22 11:03:21   4458s] @file 61: # Signoff timing with QRC map file
[03/22 11:03:21   4458s] @file 62: # ##############################################################################
[03/22 11:03:21   4458s] @file 63:
[03/22 11:03:21   4458s] @file 64: proc signoff_qrc {prefix} {
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     if {[file exists "../../input/qrc.map"] == 0} {
[03/22 11:03:21   4458s]         puts "ERROR signoff_qrc. qrc.map doesn't exist. Cannot continue."
[03/22 11:03:21   4458s]         return ""
[03/22 11:03:21   4458s]     }
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     ### Runs signoff timing analysis using extraction (Quantus QRC) and Tempus in batch mode, and generates timing reports and ECO DB for each view. The command prints out a timing summary table per view and all the views combined.
[03/22 11:03:21   4458s]     ### NOTE this file is calling the qrc.map file specified by setExtractRCMode
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     #  signoff extraction
[03/22 11:03:21   4458s]     set_db extract_rc_use_qrc_oa_interface true		
[03/22 11:03:21   4458s]     set_db extract_rc_engine post_route
[03/22 11:03:21   4458s]     set_db extract_rc_effort_level signoff		
[03/22 11:03:21   4458s]     set_db extract_rc_coupled true
[03/22 11:03:21   4458s]     set_db extract_rc_lef_tech_file_map "../../input/qrc.map"
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     extract_rc
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_BEST  -spef_file $iv::OutDir/export_signoff_RC_BEST.spef
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_WORST -spef_file $iv::OutDir/export_signoff_RC_WORST.spef
[03/22 11:03:21   4458s]     write_parasitics -rc_corner RC_TYP   -spef_file $iv::OutDir/export_signoff_RC_TYP.spef
[03/22 11:03:21   4458s] 
[03/22 11:03:21   4458s]     # signoff timing analysis using TEMPUS (engine AAE)
[03/22 11:03:21   4458s]     eval_legacy { setInputTransitionDelay 100.0ps }
[03/22 11:03:21   4458s]     eval_legacy { setDefaultLoadForAllNet 0.1pf }
