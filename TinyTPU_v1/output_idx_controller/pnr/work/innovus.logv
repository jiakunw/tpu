[03/22 14:11:14     25s] @file 7: ###############################################################################
[03/22 14:11:14     25s] @file 8: #  Special treatment for TMR
[03/22 14:11:14     25s] @file 9: ###############################################################################
[03/22 14:11:14     25s] @file 10: # RX May 3, 2019
[03/22 14:11:14     25s] @file 11: # Force TMR registers to be TMR_DIST lateral distance away from each other.
[03/22 14:11:14     25s] @file 12: # To use this, TMR instances names in the source verilog code must begin with "TMR1", "TMR2", and "TMR3" for Innovus to correctly locate and group them.
[03/22 14:11:14     25s] @@file 13: select_obj [get_db insts TMR1*]
[03/22 14:11:14     25s] @file 14: set n 0
[03/22 14:11:14     25s] @file 15: foreach {ptr1} [get_db selected .name] {
[03/22 14:11:14     25s] 	
[03/22 14:11:14     25s] 	set ptr2 [regsub "TMR1" $ptr1 "TMR2"] 
[03/22 14:11:14     25s] 	set ptr3 [regsub "TMR1" $ptr1 "TMR3"] 
[03/22 14:11:14     25s] 	
[03/22 14:11:14     25s] 	# Not all TMR* instance names are actually TMR registers.  Sometimes they are auto-synthesized one-time instances inserted by Genus.
[03/22 14:11:14     25s] 	catch {create_inst_space_group tmrSpaceGrp${n} -inst [list $ptr1 $ptr2 $ptr3] -spacing_x $iv::TMRDIST -spacing_y $iv::TMRDIST}
[03/22 14:11:14     25s] 	
[03/22 14:11:14     25s] 	incr n
[03/22 14:11:14     25s] }
