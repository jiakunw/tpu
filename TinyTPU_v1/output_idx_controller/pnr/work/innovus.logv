[03/22 14:16:21    293s] #@ Begin verbose source ../scripts/signoff_timing_analysis.tcl (pre)
[03/22 14:16:21    293s] @file 1: # Rui ("Ray") Xu
[03/22 14:16:21    293s] @file 2: # Nov 2021
[03/22 14:16:21    293s] @file 3: # CISL @ Columbia, Kinget Group
[03/22 14:16:21    293s] @file 4: # Innovus: signoff_timing_analysis.tcl
[03/22 14:16:21    293s] @file 5:
[03/22 14:16:21    293s] @file 6: ###########################################################################
[03/22 14:16:21    293s] @file 7: # Signoff timing analysis using Innovus (make sure to run the separate
[03/22 14:16:21    293s] @file 8: # Tempus signoff timing afterwards)
[03/22 14:16:21    293s] @file 9: ###########################################################################
[03/22 14:16:21    293s] @file 10:
[03/22 14:16:21    293s] @file 11: ###############################################################################
[03/22 14:16:21    293s] @file 12: # Extract and time analysis
[03/22 14:16:21    293s] @file 13: ###############################################################################
[03/22 14:16:21    293s] @file 14:
[03/22 14:16:21    293s] @file 15: proc extract_and_time_design {prefix} {
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]  
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     set_db extract_rc_use_qrc_oa_interface true
[03/22 14:16:21    293s]     set_db extract_rc_coupled true
[03/22 14:16:21    293s]     eval_legacy { setDelayCalMode -engine default }
[03/22 14:16:21    293s]     set_db extract_rc_effort_level signoff
[03/22 14:16:21    293s]     set_db extract_rc_lef_tech_file_map "../../input/qrc.map"
[03/22 14:16:21    293s]     set_db timing_analysis_type ocv
[03/22 14:16:21    293s]     set_db timing_analysis_cppr both
[03/22 14:16:21    293s]     set_db delaycal_enable_si true
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     extract_rc
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_BEST  -spef_file $iv::OutDir/export_RC_BEST.spef
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_WORST -spef_file $iv::OutDir/export_RC_WORST.spef
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_TYP   -spef_file $iv::OutDir/export_RC_TYP.spef
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     #signoff timing analysis
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     time_design    \
[03/22 14:16:21    293s]         -sign_off                               \
[03/22 14:16:21    293s]         -report_only                            \
[03/22 14:16:21    293s]         -report_prefix $prefix                  \
[03/22 14:16:21    293s]         -path_report                            \
[03/22 14:16:21    293s]         -drv_report                             \
[03/22 14:16:21    293s]         -slack_report                           \
[03/22 14:16:21    293s]         -num_paths 500                          \
[03/22 14:16:21    293s]         -report_dir $iv::reportDir           \
[03/22 14:16:21    293s]         -timing_debug_report
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     time_design    \
[03/22 14:16:21    293s]         -sign_off                               \
[03/22 14:16:21    293s]         -hold                                   \
[03/22 14:16:21    293s]         -report_only                            \
[03/22 14:16:21    293s]         -report_prefix $prefix                  \
[03/22 14:16:21    293s]         -path_report                            \
[03/22 14:16:21    293s]         -slack_report                           \
[03/22 14:16:21    293s]         -num_paths 500                          \
[03/22 14:16:21    293s]         -report_dir $iv::reportDir            \
[03/22 14:16:21    293s]         -timing_debug_report
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s] }
[03/22 14:16:21    293s] @file 59:
[03/22 14:16:21    293s] @file 60: # ##############################################################################
[03/22 14:16:21    293s] @file 61: # Signoff timing with QRC map file
[03/22 14:16:21    293s] @file 62: # ##############################################################################
[03/22 14:16:21    293s] @file 63:
[03/22 14:16:21    293s] @file 64: proc signoff_qrc {prefix} {
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     if {[file exists "../../input/qrc.map"] == 0} {
[03/22 14:16:21    293s]         puts "ERROR signoff_qrc. qrc.map doesn't exist. Cannot continue."
[03/22 14:16:21    293s]         return ""
[03/22 14:16:21    293s]     }
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     ### Runs signoff timing analysis using extraction (Quantus QRC) and Tempus in batch mode, and generates timing reports and ECO DB for each view. The command prints out a timing summary table per view and all the views combined.
[03/22 14:16:21    293s]     ### NOTE this file is calling the qrc.map file specified by setExtractRCMode
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     #  signoff extraction
[03/22 14:16:21    293s]     set_db extract_rc_use_qrc_oa_interface true		
[03/22 14:16:21    293s]     set_db extract_rc_engine post_route
[03/22 14:16:21    293s]     set_db extract_rc_effort_level signoff		
[03/22 14:16:21    293s]     set_db extract_rc_coupled true
[03/22 14:16:21    293s]     set_db extract_rc_lef_tech_file_map "../../input/qrc.map"
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     extract_rc
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_BEST  -spef_file $iv::OutDir/export_signoff_RC_BEST.spef
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_WORST -spef_file $iv::OutDir/export_signoff_RC_WORST.spef
[03/22 14:16:21    293s]     write_parasitics -rc_corner RC_TYP   -spef_file $iv::OutDir/export_signoff_RC_TYP.spef
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     # signoff timing analysis using TEMPUS (engine AAE)
[03/22 14:16:21    293s]     eval_legacy { setInputTransitionDelay 100.0ps }
[03/22 14:16:21    293s]     eval_legacy { setDefaultLoadForAllNet 0.1pf }
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     ## Delay Mode
[03/22 14:16:21    293s]     eval_legacy { setDelayCalMode -engine aae } ;# Default : true
[03/22 14:16:21    293s]     set_db delaycal_enable_si true ;# Default : false
[03/22 14:16:21    293s]     set_db delaycal_equivalent_waveform_model propagation; # Default : none
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     ## SI settings
[03/22 14:16:21    293s]     set_db si_delay_separate_on_data true ;# Default : false
[03/22 14:16:21    293s]     set_db si_delay_delta_annotation_mode lumpedOnNet ;# Default : arc
[03/22 14:16:21    293s]     set_db si_delay_delta_threshold 1e-12 ;# Default : -1
[03/22 14:16:21    293s]     eval_legacy { setSIMode -use_si_slew_for_delay true } ;# Default : false
[03/22 14:16:21    293s]     set_db si_enable_glitch_propagation true ;# Default : false
[03/22 14:16:21    293s]     set_db opt_post_route_report_si_transitions true  ;# Default : false
[03/22 14:16:21    293s]     set_db timing_enable_si_cppr true  ;# Default : true
[03/22 14:16:21    293s]     set_db timing_cppr_transition_sense same_transition_expanded ;# Default : normal
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     ## STA globals
[03/22 14:16:21    293s]     set_db timing_case_analysis_for_icg_propagation always  ;# Default : false
[03/22 14:16:21    293s]     set_db timing_analysis_cppr both  ;# equivalent to legacy timing_remove_clock_reconvergence_pessimism Default : none
[03/22 14:16:21    293s]     set_db timing_report_unconstrained_paths true  ;# Default : false
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     ## Only for signoff STA (will impact runtime for optimisation)
[03/22 14:16:21    293s]     set_db si_delay_enable_double_clocking_check true  ;# Default : false
[03/22 14:16:21    293s]     set_db si_glitch_enable_report true  ;# Default : false
[03/22 14:16:21    293s]     set_db si_delay_enable_report true   ;# Default : false
[03/22 14:16:21    293s]     set_db timing_cppr_threshold_ps 0    ;# Default : 20
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     set_db delaycal_enable_si true
[03/22 14:16:21    293s]     eval_legacy { setDelayCalMode -siAware true -engine aae -mode signoff }
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     time_design    \
[03/22 14:16:21    293s]         -sign_off                                \
[03/22 14:16:21    293s]         -expanded_views                          \
[03/22 14:16:21    293s]         -report_prefix $prefix                   \
[03/22 14:16:21    293s]         -path_report                             \
[03/22 14:16:21    293s]         -drv_report                              \
[03/22 14:16:21    293s]         -slack_report                            \
[03/22 14:16:21    293s]         -num_paths 500                           \
[03/22 14:16:21    293s]         -report_dir $iv::reportDir             \
[03/22 14:16:21    293s]         -timing_debug_report -report_only
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s]     time_design    \
[03/22 14:16:21    293s]         -sign_off                                \
[03/22 14:16:21    293s]         -hold                                    \
[03/22 14:16:21    293s]         -expanded_views                          \
[03/22 14:16:21    293s]         -report_prefix $prefix                   \
[03/22 14:16:21    293s]         -path_report                             \
[03/22 14:16:21    293s]         -slack_report                            \
[03/22 14:16:21    293s]         -num_paths 500                           \
[03/22 14:16:21    293s]         -report_dir $iv::reportDir             \
[03/22 14:16:21    293s]         -timing_debug_report -report_only
[03/22 14:16:21    293s] 
[03/22 14:16:21    293s] }
