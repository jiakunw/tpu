[03/22 13:40:35    380s] @file 6: source ../scripts/makePins.tcl
[03/22 13:40:35    380s] #@ Begin verbose source ../scripts/makePins.tcl (pre)
[03/22 13:40:35    380s] @file 1:
[03/22 13:40:35    380s] @file 2: ## This procedure creates PG pins and labels for sub-blocks and wirebonded designs
[03/22 13:40:35    380s] @file 3: proc make_pins_core { }  {
[03/22 13:40:35    380s]     global vars
[03/22 13:40:35    380s]     foreach pgnet [get_db pg_nets] {
[03/22 13:40:35    380s]         set pg_stripe [lindex  [get_db $pgnet .special_wires -if { .shape == stripe || .shape == ring || .shape == corewire} ] {0} ]
[03/22 13:40:35    380s]         if { $pg_stripe != "" } {
[03/22 13:40:35    380s]             set pg_x [get_db $pg_stripe .polygon.bbox.ll.x ]
[03/22 13:40:35    380s]             set pg_y [get_db $pg_stripe .polygon.bbox.ll.y ]
[03/22 13:40:35    380s]             set pg_L [get_db $pg_stripe .layer.name ]
[03/22 13:40:35    380s]             puts "Creating OA label for PG net:  [get_db $pgnet .name]"
[03/22 13:40:35    380s]             create_pg_pin \
[03/22 13:40:35    380s]                 -name [get_db $pgnet .name] \
[03/22 13:40:35    380s]                 -net [get_db $pgnet .name]  \
[03/22 13:40:35    380s]                 -geometry $pg_L $pg_x $pg_y [expr $pg_x+1.0] [expr $pg_y+1.0]
[03/22 13:40:35    380s]             create_text \
[03/22 13:40:35    380s]                 -point $pg_x $pg_y \
[03/22 13:40:35    380s]                 -label [get_db $pgnet .name]\
[03/22 13:40:35    380s]                 -orient R0 \
[03/22 13:40:35    380s]                 -layer $pg_L \
[03/22 13:40:35    380s]                 -oa_purpose drawing \
[03/22 13:40:35    380s] 		        -height 0.1
[03/22 13:40:35    380s]         }
[03/22 13:40:35    380s]     }
[03/22 13:40:35    380s]     foreach p [get_db ports] {
[03/22 13:40:35    380s]         set edge [get_db $p .pin_edge]
[03/22 13:40:35    380s]         if {$edge == 0} { set orient R0 }
[03/22 13:40:35    380s]         if {$edge == 1} { set orient R90 }
[03/22 13:40:35    380s]         if {$edge == 2} { set orient R180 }
[03/22 13:40:35    380s]         if {$edge == 3} { set orient R270 }
[03/22 13:40:35    380s]         puts "Creating OA label for signal net: [string map { [ < ] > } [join [get_db $p .name]]]"
[03/22 13:40:35    380s]         create_text \
[03/22 13:40:35    380s]             -point [get_db $p .location.x ] [get_db $p .location.y ] \
[03/22 13:40:35    380s]             -label [string map { [ < ] > } [join [get_db $p .name]]] \
[03/22 13:40:35    380s]             -orient $orient \
[03/22 13:40:35    380s]             -layer [get_db $p .layer.name] \
[03/22 13:40:35    380s]             -oa_purpose drawing \
[03/22 13:40:35    380s] 	        -height 0.1
[03/22 13:40:35    380s]     }
[03/22 13:40:35    380s] }
[03/22 13:40:35    380s] @file 41:
[03/22 13:40:35    380s] @file 42:
[03/22 13:40:35    380s] @file 43: ### This procedure creates bumps 
[03/22 13:40:35    380s] @file 44: proc make_pins_bumps { }  {
[03/22 13:40:35    380s]     global vars
[03/22 13:40:35    380s]     foreach pgnet [concat $vars(VDD,pin) $vars(GND,pin) ] {
[03/22 13:40:35    380s]         create_pg_pin -name $pgnet -net $pgnet
[03/22 13:40:35    380s]     }
[03/22 13:40:35    380s] 
[03/22 13:40:35    380s]     foreach bump [get_db bumps] {
[03/22 13:40:35    380s]         puts [concat "-> Creating label and pin for IO bump \[" [get_db $bump .name] "\] net \[" [get_db $bump .net.name] "\]"]
[03/22 13:40:35    380s] 
[03/22 13:40:35    380s]         if { ! ([get_db $bump .net.name] in [concat $vars(VDD,pin) $vars(GND,pin) ] ) } {
[03/22 13:40:35    380s]             edit_pin \
[03/22 13:40:35    380s]                 -fixed_pin 1 -layer AP  \
[03/22 13:40:35    380s]                 -assign  [list [get_db $bump .center.x] [get_db $bump .center.y] ] \
[03/22 13:40:35    380s]                 -snap mgrid -pin_depth 0.1 -pin_width  0.1 \
[03/22 13:40:35    380s]                 -side inside -fix_overlap false -honor_constraint false     \
[03/22 13:40:35    380s]                 -pin  [get_db $bump .net.name]
[03/22 13:40:35    380s]         }
[03/22 13:40:35    380s] 
[03/22 13:40:35    380s]         create_text \
[03/22 13:40:35    380s]             -point [get_db $bump .center.x] [get_db $bump .center.y] \
[03/22 13:40:35    380s]             -label [string map { [ < ] > } [join [get_db $bump .net.name] ]] \
[03/22 13:40:35    380s]             -orient R0 -layer AP -height 10 \
[03/22 13:40:35    380s]             -oa_purpose drawing \
[03/22 13:40:35    380s] 	        -height 0.1
[03/22 13:40:35    380s]     }
[03/22 13:40:35    380s] }
[03/22 13:40:35    380s] #@ End verbose source ../scripts/makePins.tcl
[03/22 13:40:35    380s] @file 7:
[03/22 13:40:35    380s] @file 8: ###############################################################################
[03/22 13:40:35    380s] @file 9: # VDD/GND PINS and PIN LABELS CREATION
[03/22 13:40:35    380s] @file 10: ###############################################################################
[03/22 13:40:35    380s] @@file 11: create_pg_pin -name $iv::PWR_name -net $iv::PWR_name
