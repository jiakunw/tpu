[03/22 13:33:53     25s] @file 52: source ../../input/user_timing_derating.tcl
[03/22 13:33:53     25s] #@ Begin verbose source ../../input/user_timing_derating.tcl (pre)
[03/22 13:33:53     25s] @file 1: # Rui ("Ray") Xu
[03/22 13:33:53     25s] @file 2: # Nov 2021
[03/22 13:33:53     25s] @file 3: # CISL @ Columbia, Kinget Group
[03/22 13:33:53     25s] @file 4: # user_timing_derating.tcl
[03/22 13:33:53     25s] @file 5:
[03/22 13:33:53     25s] @file 6: # Optional.  
[03/22 13:33:53     25s] @file 7: # Allows user to specify custom timing derating scale factors.
[03/22 13:33:53     25s] @file 8:
[03/22 13:33:53     25s] @file 9: #####################################################################
[03/22 13:33:53     25s] @file 10: # User-specified de-rating
[03/22 13:33:53     25s] @file 11: #####################################################################
[03/22 13:33:53     25s] @file 12: # adds pessimism to the hold analysis by making the latching clock path 20 percent slower.
[03/22 13:33:53     25s] @@file 13: set_timing_derate -delay_corner dc_min -late 1.2
[03/22 13:33:53     25s] @@file 14: set_timing_derate -delay_corner dc_min_lt -late 1.2
[03/22 13:33:53     25s] @file 15: # adds pessimism to the setup analysis by making the latching clock path 20 percent faster.
[03/22 13:33:53     25s] @@file 16: set_timing_derate -delay_corner dc_max -early 0.8
